{
  "expo": {
    "name": "FitLens",
    "slug": "fitlens",
    "version": "0.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "fitlens",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitlens.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "FitLens 需要访问相册，用于选择餐食照片或运动截图进行识别。",
        "NSCameraUsageDescription": "FitLens 需要使用相机，用于拍摄餐食照片或运动截图进行识别。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#34D399"
      },
      "package": "com.fitlens.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitLens 需要访问相册，用于选择餐食照片或运动截图进行识别。",
          "cameraPermission": "FitLens 需要使用相机，用于拍摄餐食照片进行识别。",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae28a343-c5c5-46a7-be00-ae53647211ae"
      }
    },
    "owner": "lidongyang"
  }
}
